# ExceptionOS Production & Local Configuration

# Server Port (Render sets this automatically)
PORT=8000

# CORS Allowed Origins (Comma-separated for multiple domains, or '*' for any origin)
# Vercel deployments (*.vercel.app) are allowed by default
CORS_ORIGINS=https://exceptionos.vercel.app

# Python Path (Set to 'src' on Render so package imports cleanly)
PYTHONPATH=src

# AI Intelligence Layer Configuration
# Options: 'groq', 'openai', or 'mock' (default fallback with zero runtime failure)
AI_PROVIDER=groq

# Groq Settings (recommended for low-latency inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# OpenAI Settings (if AI_PROVIDER=openai)
AI_API_KEY=your_openai_api_key_here
